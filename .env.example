# 本项目的ENV模板，旨在提示本项目需要的环境变量，除非只在本地否则不要使用`.env`文件
# ==============================================
# PROJECT SETTINGS (项目基础配置)
# ==============================================
# 运行环境: dev, docs, build
APP_ENV=dev
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 时区设置
TZ=Asia/Shanghai

# ==============================================
# STORAGE & DATABASE (R2 存储与 LanceDB)
# ==============================================
# Cloudflare R2 配置 (兼容 S3)
R2_ACCOUNT_ID= <your_cloudflare_account_id>
R2_ACCESS_KEY_ID= <your_r2_access_key>
R2_SECRET_ACCESS_KEY= <your_r2_secret_key>
# R2 桶名称 (eg: redate-news-store)
R2_BUCKET_NAME= <the name you like>
# R2 端点 (e.g., https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL= <https://your_cloudflare_account_id.r2.cloudflarestorage.com>

# LanceDB 向量数据库路径 (容器内路径，usually default)
LANCEDB_URI=/app/data/lancedb

# ==============================================
# AI & LLM SERVICES (Google Gemini)
# ==============================================
# Google Gemini API Key
GEMINI_API_KEY= <your_gemini_api_key_primary>
# (Optional) Secondary API Key for load balancing/rotation
GEMINI_API_KEY_ALT= <your_gemini_api_key_secondary>
# 嵌入模型名称
EMBEDDING_MODEL=models/embedding-001
# 生成模型名称 (周报/年报)
GENERATIVE_MODEL=models/gemini-2.5-flash-preview-09-2025

# ==========================================
# Data Sources
# ==========================================
# Viki News API Base URL
VIKI_API_BASE=https://60s.viki.moe/v2
# Unsplash Access Key (Client ID)
UNSPLASH_ACCESS_KEY= <your_unsplash_access_key>
# Pexels API Key
PEXELS_API_KEY= <your_pexels_api_key>
# Pixabay API Key
PIXABAY_API_KEY= <your_pixabay_api_key>

# ==============================================
# PUBLISHING CHANNELS (微信公众号)
# ==============================================
# 微信公众号 App ID
WECHAT_APP_ID=
# 微信公众号 App Secret
WECHAT_APP_SECRET=

# ==============================================
# NETWORK & PROXY (网络代理配置)
# ==============================================
# VPS 远程主机地址 (用于客户端连接)
VPS_HOST=
# VPS 代理服务端口定义 (用于 CI/CD 注入)
VPS_QUIC_PORT=8443
VPS_WSS_PORT=8444
VPS_SSH_PORT=8445

# HTTP/SOCKS 代理地址 (容器内部使用)
# In Docker, this points to the sidecar service name.
# Local Dev Example: socks5://127.0.0.1:1080
ALL_PROXY=socks5://redate-proxy:1080
# 微信发布专用代理
WECHAT_PROXY_URL=socks5://redate-proxy:1080