# =============================================================================
# ARCHITECTURE GUARDRAILS (Strict Layering & Independence)
# =============================================================================
[importlinter]
root_package = redate
include_external_packages = True

# =============================================================================
# CONTRACT 1: STRICT LAYERING (The Onion)
# =============================================================================
# This defines the "physical" containment hierarchy.
# High-level modules (top) can import Low-level modules (bottom),
# BUT we will use Contract 2 to prevent Service -> Adapter specifically.
[importlinter:contract:1]
name = Enforce Physical Layer Hierarchy
type = layers
layers =
    # Level 1: Entry Points (CLI, API handlers)
    redate.main
    # Level 2: Business Logic (Services) & Interfaces (Ports)
    # Service 层协调业务，Ports 定义接口
    redate.service_.* | redate.ports
    # Level 3: Adapters (Infrastructure Implementation)
    # 适配器实现 Ports 接口，被 Service 调用（通过依赖注入）
    # 注意：物理上 Service 和 Adapter 可能同级，但逻辑上 Service 不应直接 import Adapter 具体实现
    redate.adapter_.*
    # Level 4: Core Domain (Pure Python Entities)
    redate.domain_models
    # Level 5: Shared Utils
    redate.utils_.*

# =============================================================================
# CONTRACT 2: DEPENDENCY INVERSION PRINCIPLE (DIP)
# =============================================================================
# 核心业务逻辑 (Service) 禁止直接导入基础设施实现 (Adapter)
# 必须通过 Ports (Interfaces) 进行交互
[importlinter:contract:2]
name = Enforce Dependency Inversion (Service -> X -> Adapter)
type = forbidden
source_modules =
    redate.service_news
forbidden_modules =
    redate.adapter_gemini
    redate.adapter_openai
    redate.adapter_storage
    redate.adapter_viki
    redate.adapter_image
    redate.adapter_wechat
    # Regex pattern support depends on import-linter version, explicit listing is safer
    # redate.adapter_.* 

# =============================================================================
# CONTRACT 3: DOMAIN PURITY
# =============================================================================
# The Domain Model should be a pure data/logic layer. 
# It must not know about databases, APIs, or the web framework.
[importlinter:contract:3]
name = Domain Model Purity
type = forbidden
source_modules =
    redate.domain_models
forbidden_modules =
    redate.main
    redate.service_.*
    redate.ports
    redate.adapter_.*
    # Prevent accidental usage of heavy external libs in domain
    fastapi
    flask
    django
    pydantic_settings
    boto3
    aioboto3
    google.generativeai
    google.genai

# =============================================================================
# CONTRACT 4: INFRASTRUCTURE ISOLATION
# =============================================================================
# One adapter should not depend on another adapter (e.g., WeChat shouldn't need S3 code).
# They should interact only via the Service layer or Domain objects.
[importlinter:contract:4]
name = Infrastructure Independence
type = independence
modules =
    redate.adapter_gemini
    redate.adapter_openai
    redate.adapter_storage
    redate.adapter_viki
    redate.adapter_image
    redate.adapter_wechat